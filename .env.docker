# ─────────────────────────────────────────────────────────────────────
# Auth Service — Docker environment
# Usage:  cp .env.docker .env
#
# DO NOT commit .env — this file is the template.
# Real secrets go in .env (gitignored).
# ─────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────
APP_NAME="Auth Service"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_SUPPORTED_LOCALES=es,en

# Generate with:  docker compose exec app php artisan key:generate
APP_KEY=

# ── Database ──────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql          # service name in docker-compose.yml
DB_PORT=3306
DB_DATABASE=pharmacy_auth
DB_USERNAME=auth_user
DB_PASSWORD=auth_pass

# ── Cache & Queues — Option B: Redis ─────────────────────────────────
# Option A (shared hosting): set CACHE_DRIVER=database, QUEUE_CONNECTION=sync
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis       # service name in docker-compose.yml
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── JWT — RS256 ───────────────────────────────────────────────────────
# Generate keys with:
#   docker compose exec app php artisan auth:generate-keys
# Keys are stored in storage/keys/ (mapped to named volume, NOT in git)
JWT_PRIVATE_KEY_PATH=/var/www/storage/keys/private.pem
JWT_PUBLIC_KEY_PATH=/var/www/storage/keys/public.pem
JWT_CURRENT_KID=key-2024-01

# Token TTLs (seconds)
ACCESS_TOKEN_TTL_SECONDS=300      # 5 minutes — ADR-01
REFRESH_TOKEN_TTL_SECONDS=28800   # 8 hours

# SEC-14: cookie | body
# Use 'body' for local development; 'cookie' for web frontend
REFRESH_TOKEN_MODE=body

# ── Rate limiting ─────────────────────────────────────────────────────
# SEC-04 — Dual rate limiting thresholds
RATE_LIMIT_IP_MAX_ATTEMPTS=5
RATE_LIMIT_IP_DECAY_MINUTES=10
RATE_LIMIT_EMAIL_MAX_ATTEMPTS=10
RATE_LIMIT_EMAIL_DECAY_MINUTES=15
RATE_LIMIT_BRUTE_FORCE_THRESHOLD=20
RATE_LIMIT_BRUTE_FORCE_WINDOW_MINUTES=60

# ── Logging ───────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ── Services ──────────────────────────────────────────────────────────
# Base URL of this service (used for JWKS issuer claim)
AUTH_SERVICE_URL=http://localhost:8000
JWT_ISSUER=pharmacy-auth-service
