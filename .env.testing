APP_NAME=pharmacy-auth-service
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pharmacy_auth_test
DB_USERNAME=auth_user
DB_PASSWORD=auth_pass

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

JWT_PRIVATE_KEY_PATH=/var/www/storage/keys/private.pem
JWT_PUBLIC_KEY_PATH=/var/www/storage/keys/public.pem
JWT_CURRENT_KID=key-2024-01
ACCESS_TOKEN_TTL_SECONDS=300
JWT_ISSUER=pharmacy-auth-service

REDIS_HOST=redis
REDIS_PORT=6379
