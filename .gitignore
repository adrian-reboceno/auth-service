# ─────────────────────────────────────────────────────────────────────
# Auth Service — .gitignore
# ─────────────────────────────────────────────────────────────────────

# Laravel
/vendor/
/node_modules/
.env
.env.backup
.env.*.local

# RSA Keys — NEVER commit private keys
/storage/keys/
/tests/keys/
*.pem
*.key

# Logs
/storage/logs/*.log
/docker/mysql/slow.log

# Test coverage report
/coverage/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Docker volumes (if accidentally created locally)
mysql_data/
redis_data/