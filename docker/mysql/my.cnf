[mysqld]
# ─────────────────────────────────────────────────────────────────────
# Auth Service — MySQL 8 configuration
# ─────────────────────────────────────────────────────────────────────

# CRITICAL: allows triggers defined in migrations (SEC-08)
# Without this, MySQL rejects CREATE TRIGGER when binary log is enabled
log_bin_trust_function_creators = 1

# Full UTF-8 — required for international names and emails
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# Strict mode — catches implicit type coercions early
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# Timezone
default-time-zone = '+00:00'

# InnoDB — required for FK constraints and transactions (CRIT-05)
default-storage-engine = InnoDB
innodb_strict_mode     = ON

# Slow query log — useful during development
slow_query_log       = ON
slow_query_log_file  = /var/lib/mysql/slow.log
long_query_time      = 1

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
